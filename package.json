{
  "name": "keypad-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/check-budget.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run knip && npm run test && npm run build",
    "icons": "node --experimental-strip-types scripts/render-icons.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test:all": "npm run check && npm run e2e",
    "levels:solve": "sh scripts/rebound-levels/solve.sh",
    "levels:trace": "tsx scripts/rebound-levels/trace.ts",
    "deploy": "npx --yes vercel@65.2.0 deploy --prod",
    "build:api": "vite build --config vite.api.config.ts",
    "api:check": "npm run build:api && git diff --exit-code --stat -- api && test -z \"$(git ls-files --others --exclude-standard api)\"",
    "test:server": "vitest run --config vitest.server.config.ts",
    "redis:test": "sh scripts/test-redis.sh",
    "e2e:leaderboard": "E2E_LEADERBOARD=1 playwright test --workers=1 --project=leaderboard-android --project=leaderboard-iphone",
    "api:dev": "tsx --tsconfig tsconfig.node.json scripts/dev-api.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@upstash/redis": "1.39.0",
    "dexie": "4.4.7",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
